<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Shown from the launcher tap until Flutter draws its first frame, when the device's
         dark mode is off. It follows the device, not the theme chosen in Settings: Flutter
         hasn't started, so the stored choice can't be read yet. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/window_background</item>
        <!-- Android 12+ draws its own launch screen with the app icon; keep it a plain colour. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>
    </style>
    <!-- The window behind Flutter's UI while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
